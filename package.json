{
  "name": "multi-agent-platform",
  "version": "1.0.0",
  "packageManager": "pnpm@10.17.0",
  "description": "A fully self-hosted multi-agent platform for developing software and applications using TypeScript, LangGraph, BookStack, GitHub, and LangFuse.",
  "main": "dist/index.js",
  "bin": {
    "multi-agent": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "pnpm --parallel --filter web --filter server run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:cli": "ts-node src/cli/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "dev:server": "pnpm --filter server dev",
    "dev:all": "pnpm --parallel --filter web --filter server run dev",
    "db:dev:up": "docker compose -f infrastructure/memory/compose.yml --profile memory up -d",
    "db:dev:down": "docker compose -f infrastructure/memory/compose.yml --profile memory down",
    "db:migrate": "node -r dotenv/config infrastructure/memory/migrate.cjs && node -r dotenv/config infrastructure/studio/migrate.cjs",
    "worker:image:build": "docker build --pull --platform linux/amd64 --build-arg HTTP_PROXY --build-arg HTTPS_PROXY --build-arg NO_PROXY --file infrastructure/docker/worker.Dockerfile --tag multi-agent-cli-worker:local infrastructure/docker",
    "worker:image:smoke": "ts-node --transpile-only infrastructure/docker/smoke-worker-image.ts",
    "worker:e2e:codex-auth-file": "ts-node --transpile-only infrastructure/docker/e2e-codex-auth-file.ts",
    "worker:e2e:claude-auth-file": "ts-node --transpile-only infrastructure/docker/e2e-claude-auth-file.ts",
    "worker:e2e:multi-agent-workflow": "ts-node --transpile-only infrastructure/docker/e2e-multi-agent-workflow.ts",
    "worker:e2e:resilience-pg": "ts-node --transpile-only infrastructure/docker/e2e-resilience-pg.ts",
    "verification:load": "ts-node --transpile-only infrastructure/docker/verification-load-smoke.ts --scenario load",
    "verification:docker": "ts-node --transpile-only infrastructure/docker/verification-load-smoke.ts --scenario docker",
    "verification:real-tools": "ts-node --transpile-only infrastructure/docker/verification-real-tools.ts",
    "credentials:login-codex": "ts-node --transpile-only scripts/login-agent-codex.ts",
    "credentials:status-codex": "ts-node --transpile-only scripts/login-agent-codex.ts -- --status",
    "memory:backfill-embeddings": "node scripts/memory/backfill-embeddings.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.4",
    "@langchain/anthropic": "^0.3.15",
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^0.2.18",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "^0.4.4",
    "@langfuse/tracing": "^5.11.0",
    "@multi-agent/types": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "axios": "^1.7.9",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.20",
    "inquirer": "^9.3.8",
    "langfuse": "^3.35.0",
    "langfuse-langchain": "^3.35.0",
    "pg": "^8.23.0",
    "undici": "^8.10.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
