# LLM API Keys & Provider ("openai", "anthropic", or "gemini")
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# DevOps Provider Selection ("github" or "azure-devops")
DEVOPS_PROVIDER=github

# GitHub Service (https://api.github.com)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=your-github-username

# BookStack Service (Self-Hosted: http://172.17.0.1:7875)
BOOKSTACK_BASE_URL=http://172.17.0.1:7875
BOOKSTACK_TOKEN_ID=your-bookstack-token-id
BOOKSTACK_TOKEN_SECRET=your-bookstack-token-secret

# Deep observability (optional; server-side only). Langfuse is not required for runs.
# OBSERVABILITY_ENABLED=false
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # or your compatible self-hosted instance
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=git-sha-or-deployment-version
# OBSERVABILITY_CAPTURE_MODE=redacted            # full | redacted | metadata-only
# OBSERVABILITY_MAX_PAYLOAD_CHARS=8000
# OBSERVABILITY_SAMPLE_RATE=1

# Runtime guardrails (server-owned limits)
# WORKFLOW_MAX_NODES=100
# WORKFLOW_MAX_EDGES=250
# WORKFLOW_MAX_BRANCHES=25
# WORKFLOW_RECURSION_LIMIT=100
# RUN_MAX_DURATION_MS=900000
# AGENT_MAX_DURATION_MS=120000
# TOOL_MAX_DURATION_MS=30000
# TOOL_ALLOW_SIDE_EFFECTS=false

# CLI agent execution (disabled until explicitly enabled; server-owned allowlists)
# CLI_AGENT_ENABLED=false
# CLI_AGENT_ALLOWED_EXECUTABLES=codex,claude,agy
# CLI_AGENT_WORKSPACE_ROOTS=/absolute/path/to/allowed/workspaces
# CLI_AGENT_MAX_OUTPUT_BYTES=1048576

# Local model endpoints (exact origins; defaults shown)
# LOCAL_MODEL_ALLOWED_ORIGINS=http://127.0.0.1:11434,http://localhost:11434,http://127.0.0.1:1234,http://localhost:1234

# Azure DevOps Integration (Optional cloud SaaS: dev.azure.com)
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/myorg
AZURE_DEVOPS_PROJECT=MyProject
AZURE_DEVOPS_PAT=your-azure-devops-pat-token

# Studio persistence (Phase 9) — same isolated Postgres as memory; never Langfuse DB
# MEMORY_DATABASE_URL=postgresql://studio_memory:studio_memory_local@127.0.0.1:55432/studio_memory
# STUDIO_DATABASE_URL=   # optional alias; MEMORY_DATABASE_URL is preferred
# STUDIO_STORE=postgres  # postgres | in-memory | disabled (defaults to postgres when a URL is set)
# EXECUTION_SERVER_URL=http://localhost:4000
# INTERNAL_PRINCIPAL_SECRET=replace-with-the-same-long-random-secret-in-web-and-server
# WEB_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Long-term memory (Phase 6/8)
# MEMORY_STORE=postgres
# MEMORY_VECTOR_ENABLED=true
# MEMORY_DEFAULT_TTL_DAYS=90
# MEMORY_PRINCIPALS=[{"token":"dev-token","principalId":"user-1","tenantId":"tenant-1"}]
