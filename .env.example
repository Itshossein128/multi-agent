# LLM API Keys & Provider ("openai", "anthropic", or "gemini")
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# DevOps Provider Selection ("github" or "azure-devops")
DEVOPS_PROVIDER=github

# GitHub Service (https://api.github.com)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=your-github-username

# BookStack Service (Self-Hosted: http://172.17.0.1:7875)
BOOKSTACK_BASE_URL=http://172.17.0.1:7875
BOOKSTACK_TOKEN_ID=your-bookstack-token-id
BOOKSTACK_TOKEN_SECRET=your-bookstack-token-secret

# Deep observability (optional; server-side only). Langfuse is not required for runs.
# OBSERVABILITY_ENABLED=false
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # or your compatible self-hosted instance
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=git-sha-or-deployment-version
# OBSERVABILITY_CAPTURE_MODE=redacted            # full | redacted | metadata-only
# OBSERVABILITY_MAX_PAYLOAD_CHARS=8000
# OBSERVABILITY_SAMPLE_RATE=1

# Runtime guardrails (server-owned limits)
# WORKFLOW_MAX_NODES=100
# WORKFLOW_MAX_EDGES=250
# WORKFLOW_MAX_BRANCHES=25
# WORKFLOW_RECURSION_LIMIT=100
# WORKFLOW_MAX_STEPS=1000
# WORKFLOW_MAX_CONCURRENT_BRANCHES=8
# NODE_RETRY_MAX_ATTEMPTS=3
# NODE_RETRY_MAX_BACKOFF_MS=30000
# RUN_MAX_DURATION_MS=900000
# RUN_MAX_EVENTS=10000
# RUN_EVENT_MAX_PAYLOAD_BYTES=65536
# RUN_MAX_PAYLOAD_BYTES=262144
# Agent prompts that include repository and documentation context may need more
# than two minutes; keep this bounded and tune it per deployment.
# AGENT_MAX_DURATION_MS=300000
# AGENT_MAX_OUTPUT_BYTES=262144
# TOOL_MAX_DURATION_MS=30000
# TOOL_MAX_OUTPUT_BYTES=262144
# TOOL_ALLOW_SIDE_EFFECTS=false
# Repository test tools are disabled by default and always run through a worker.
# TOOL_REPO_TESTS_ENABLED=false
# Fixed repository verification checks are also disabled by default. Supported
# checks are test,typecheck,build,lint,diff; arbitrary commands are not allowed.
# TOOL_REPO_CHECKS_ENABLED=false
# TOOL_REPO_TESTS_WORKER_MODE=container             # container | local (local is trusted-only)
# TOOL_REPO_TEST_WORKSPACE_ROOTS=/absolute/path/to/allowed/workspaces
# TOOL_REPO_TEST_ALLOWED_EXECUTABLES=node,git
# TOOL_REPO_PACKAGE_MANAGER=pnpm                    # pnpm | npm | yarn | bun
# TOOL_REPO_TEST_TIMEOUT_MS=30000
# TOOL_REPO_TEST_MAX_OUTPUT_BYTES=262144
# TOOL_WORKER_IMAGE=registry/agent@sha256:...       # optional override; otherwise CLI_WORKER_IMAGE
# TOOL_WORKER_DOCKER_EXECUTABLE=docker              # optional override
# Real server-side tools are disabled unless their credential gateway is enabled.
# TOOL_CREDENTIAL_GATEWAY_ENABLED=false
# TOOL_CREDENTIAL_GATEWAY_TTL_MS=30000
# ---------------------------------------------------------------------------
# External Credential Broker (production multi-tenant path)
# ---------------------------------------------------------------------------
# Precedence when both old and new variables exist:
#   CREDENTIAL_BROKER_* wins over TOOL_CREDENTIAL_GATEWAY_*.
# Production (NODE_ENV=production) requires a valid external broker and will
# refuse to start without one; the process-local EnvironmentCredentialGateway
# is development/single-server only and is never selected in production.
# URLs must be HTTP(S) without embedded credentials or query strings.
CREDENTIAL_BROKER_URL=https://credential-broker.internal
CREDENTIAL_BROKER_SERVICE_TOKEN=
CREDENTIAL_BROKER_CA_FILE=
CREDENTIAL_BROKER_CLIENT_CERT_FILE=
CREDENTIAL_BROKER_CLIENT_KEY_FILE=
CREDENTIAL_BROKER_REQUEST_TIMEOUT_MS=3000
CREDENTIAL_BROKER_MAX_TTL_MS=30000
CREDENTIAL_BROKER_REQUIRE_MTLS=true
CREDENTIAL_BROKER_ENABLED=false
CREDENTIAL_BROKER_FAIL_CLOSED=true
CREDENTIAL_BROKER_RATE_LIMIT_ENABLED=true
CREDENTIAL_BROKER_AUDIT_ENABLED=true
# Broker issuance retry budget (idempotent via Idempotency-Key). 0-3.
# CREDENTIAL_BROKER_ISSUE_RETRIES=1
# Explicit acknowledgment that the execution server transiently holds worker
# secrets (server-mediated delivery). Required in production when
# CLI_CREDENTIAL_BROKER_ENABLED=true; worker-direct lease consumption is the
# target architecture (see docs/implementation-gaps.md).
# CREDENTIAL_BROKER_TRUSTED_SERVER_DELIVERY=false
# Broker-side (standalone broker process) configuration:
# CREDENTIAL_BROKER_PORT=8484
# CREDENTIAL_BROKER_SERVICE_TOKENS=execution-server:rotatable-token:leases:issue+leases:consume+leases:revoke+audit:read
# CREDENTIAL_BROKER_SERVER_CERT_FILE=
# CREDENTIAL_BROKER_SERVER_KEY_FILE=
# CREDENTIAL_BROKER_VAULT_URL=https://vault.internal
# CREDENTIAL_BROKER_VAULT_TOKEN=
# CREDENTIAL_BROKER_VAULT_MOUNT=secret
# CREDENTIAL_BROKER_DATABASE_URL=postgresql://broker:...@127.0.0.1:55433/broker
# CREDENTIAL_BROKER_ENABLED_PROVIDERS=openai,anthropic,gemini,codex,claude-code,cursor,agy,database,search,mcp
# CREDENTIAL_BROKER_DEFAULT_TTL_MS=30000
# CREDENTIAL_BROKER_MIN_TTL_MS=1000
# CREDENTIAL_BROKER_ISSUE_PER_TENANT_PER_MIN=60
# CREDENTIAL_BROKER_CONSUME_ATTEMPTS_PER_LEASE=5
# CREDENTIAL_BROKER_ACTIVE_LEASES_PER_TENANT=25
# CREDENTIAL_BROKER_CONSUME_PER_TENANT_PER_MIN=120
# Worker CLI credentials via broker (server-mediated, trusted-only):
# CLI_CREDENTIAL_BROKER_ENABLED=false
# CLI_CREDENTIAL_BROKER_ALIAS_CODEX=
# CLI_CREDENTIAL_BROKER_ALIAS_CLAUDE_CODE=
# CLI_CREDENTIAL_BROKER_ALIAS_CURSOR=
# API model provider credentials via broker (server-owned aliases):
# API_CREDENTIAL_LEASED_PROVIDERS=
# API_CREDENTIAL_ALIAS_OPENAI=
# API_CREDENTIAL_ALIAS_ANTHROPIC=
# API_CREDENTIAL_ALIAS_GEMINI=
# For single-server development, prefer the legacy gateway variables:
# TOOL_CREDENTIAL_GATEWAY_URL=https://credential-gateway.internal/
# TOOL_CREDENTIAL_GATEWAY_SERVICE_TOKEN=              # server-only, never browser-visible
# Example server-owned mappings (never put these in ToolRecord.configuration):
# TOOL_DATABASE_MAIN_URL=postgresql://...
# TOOL_SEARCH_WEB_URL=https://search.example/api/query
# TOOL_SEARCH_WEB_API_KEY=...
# TOOL_MCP_LOCAL_URL=http://127.0.0.1:8811/mcp
# TOOL_MCP_LOCAL_TOKEN=...

# CLI agent execution (disabled until explicitly enabled; server-owned allowlists)
# CLI_AGENT_ENABLED=false
# CLI_AGENT_ALLOWED_EXECUTABLES=codex,claude,agy,agent
# agy 1.2.5 local mode needs agy installed/authenticated for the server OS user;
# the default Docker worker image excludes agy.
# Codex, Claude Code, and the Cursor Agent CLI (`agent`) are installed in the
# default digest-pinned worker image; the Cursor CLI is pinned to the artifact
# version the official installer downloads (see infrastructure/docker/worker.Dockerfile).
# CLI_AGENT_WORKSPACE_ROOTS=/absolute/path/to/allowed/workspaces
# CLI_AGENT_MAX_OUTPUT_BYTES=1048576
# WORKER_ALLOWED_ENV_KEYS=TERM,COLORTERM          # non-secret compatibility values only
# agy requires the proxy in this environment and returns HTTP 403 without it. Deployments requiring
# proxy variables must explicitly allowlist only the needed names; the corresponding proxy variables
# must already exist in the server environment and proxy URLs containing credentials must not be forwarded:
# WORKER_ALLOWED_ENV_KEYS=HTTP_PROXY,HTTPS_PROXY,ALL_PROXY,NO_PROXY,http_proxy,https_proxy,all_proxy,no_proxy
# CLI_WORKER_MODE=container                     # local | container (use container for separate agent accounts)
# CLI_WORKER_IMAGE=sha256:<64-hex>              # local image id OR registry@sha256 digest (not a :tag)
# Local (no registry push): pnpm worker:image:build
#   then: docker image inspect multi-agent-cli-worker:local --format "{{.Id}}"
# CLI_WORKER_ALLOW_NETWORK=true                 # required for live Codex/Claude/agy provider calls
# CLI_WORKER_DOCKER_EXECUTABLE=docker
# CLI_WORKER_MEMORY=1g
# CLI_WORKER_CPUS=1
# CLI_WORKER_PIDS_LIMIT=128
# CLI_WORKER_USER=65534:65534
#
# Separate developer vs agent Codex accounts (recommended for local dev):
# 1) Keep account A in the normal user home: ~/.codex/auth.json
# 2) Login account B into an isolated home (does not touch account A):
#      pnpm credentials:login-codex
# 3) Point the server at that isolated auth.json only:
# CLI_CREDENTIAL_FILE_ENABLED=true
# CLI_CODEX_AUTH_FILE=/absolute/path/to/repo/.local/agent-credentials/codex/auth.json
# CLI_CLAUDE_CREDENTIALS_FILE=/absolute/path/to/repo/.local/agent-credentials/claude/.credentials.json
# CLI_CREDENTIAL_ENVIRONMENT_ENABLED=false
# CLI_CODEX_CREDENTIAL_ENV_VAR=OPENAI_API_KEY
# CLI_CLAUDE_CREDENTIAL_ENV_VAR=ANTHROPIC_API_KEY
# CLI_CURSOR_CREDENTIAL_ENV_VAR=CURSOR_API_KEY
# CURSOR_API_KEY=cursor_...                           # required for Cursor; server-side only, never commit
# If CLI_CURSOR_CREDENTIAL_ENV_VAR is omitted, Cursor defaults to CURSOR_API_KEY.
# If CLI_CODEX_AUTH_FILE is omitted, file delivery falls back to ~/.codex/auth.json
# (same file as your developer login) — set an explicit path to keep accounts separate.
# File delivery copies only the provider credential unit into the per-run worker
# tmpfs and may write refreshed tokens back to the server-owned source under a lock.
# Environment delivery exposes the value to the CLI process and Docker daemon.
# Neither is the production multi-tenant credential boundary.

# Local model endpoints (exact origins; defaults shown)
# LOCAL_MODEL_ALLOWED_ORIGINS=http://127.0.0.1:11434,http://localhost:11434,http://127.0.0.1:1234,http://localhost:1234

# Azure DevOps Integration (Optional cloud SaaS: dev.azure.com)
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/myorg
AZURE_DEVOPS_PROJECT=MyProject
AZURE_DEVOPS_PAT=your-azure-devops-pat-token

# Studio persistence (Phase 9) — same isolated Postgres as memory; never Langfuse DB
MEMORY_DATABASE_URL=postgresql://studio_memory:studio_memory_local@127.0.0.1:55432/studio_memory
STUDIO_DATABASE_URL=
MEMORY_STORE=postgres
STUDIO_STORE=postgres
STUDIO_MEMORY_POSTGRES_PORT=55432
STUDIO_MEMORY_POSTGRES_PASSWORD=studio_memory_local
# EXECUTION_SERVER_URL=http://localhost:4000
# INTERNAL_PRINCIPAL_SECRET=replace-with-the-same-long-random-secret-in-web-and-server
# WEB_ORIGIN=http://localhost:3060,http://localhost:3061,http://localhost:3062

# Auth.js (apps/web). Next.js only loads env files from apps/web/, not the repo root.
# Copy AUTH_SECRET and MEMORY_DATABASE_URL into apps/web/.env.local.
# Generate with: openssl rand -base64 32
# AUTH_SECRET=replace-with-a-long-random-secret

# Long-term memory (Phase 6/8)
# MEMORY_STORE=postgres
# MEMORY_VECTOR_ENABLED=true
# MEMORY_DEFAULT_TTL_DAYS=90
# MEMORY_PRINCIPALS=[{"token":"dev-token","principalId":"user-1","tenantId":"tenant-1"}]
#
# Semantic/Vector Memory Configuration
# =====================================
# Set MEMORY_VECTOR_ENABLED=true AND MEMORY_EMBEDDINGS_ENABLED=true to enable
# pgvector-backed semantic retrieval. Without embeddings, only lexical retrieval works.
#
# Required for vector retrieval:
# MEMORY_EMBEDDINGS_ENABLED=true
# MEMORY_EMBEDDING_URL=https://api.openai.com/v1/embeddings
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_EMBEDDING_DIMENSIONS=1536
#
# Optional:
# MEMORY_EMBEDDING_PROVIDER=openai-compatible   # provider label for metadata
# MEMORY_EMBEDDING_VERSION=1                     # version tag; change when model changes
# MEMORY_EMBEDDING_API_KEY=sk-...                # API key for embedding service
#
# Embedding backfill (run once after enabling vector retrieval):
# pnpm memory:backfill-embeddings
